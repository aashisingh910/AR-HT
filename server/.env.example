# Copy to .env (or set these in your host). Nothing here needs Docker, Postgres or a cloud account.
PORT=4000
NODE_ENV=development
# Required in production, 16+ random characters: openssl rand -hex 32
JWT_SECRET=
# The address the phone uses to reach this server (builds absolute URLs for model files and share links)
PUBLIC_URL=http://localhost:4000
# SQLite file and uploaded-files folder. Put both on a persistent disk in production.
DB_FILE=./data/furni.db
UPLOAD_DIR=./uploads
# Optional: serve model files from a CDN / static host that mirrors UPLOAD_DIR
CDN_BASE_URL=
# Browser origins allowed to call the API (comma separated). The admin page is same-origin.
CORS_ORIGINS=
# Optional AI room layouts
ANTHROPIC_API_KEY=
LAYOUT_MODEL=claude-sonnet-5-5
LOG_LEVEL=info
# Error reporting (Sentry DSN). Leave empty to switch off.
SENTRY_DSN=
# Sign-in with Google / Apple (leave empty to switch them off)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=
APPLE_SERVICE_ID=
# Email for verification and password reset: console (prints it) or resend
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=HomeTown AR <no-reply@yourdomain.com>
