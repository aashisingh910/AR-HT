# Backend for the catalogue and cloud-saved designs. Leave unset to run fully offline with the bundled catalogue.
# Phone on your Wi-Fi: http://<computer-LAN-IP>:4000   Android emulator: http://10.0.2.2:4000   (with or without /v1)
EXPO_PUBLIC_API_URL=
# Set to 1 only when RV_API_KEY / RV_PROJECT_ID were provided at prebuild (see app.config.js).
EXPO_PUBLIC_CLOUD_ANCHORS=
# Set to 1 to show optional reference prices.
EXPO_PUBLIC_SHOW_PRICES=
EXPO_PUBLIC_APP_ENV=development
# Domain for shared design links (https://<domain>/d/<slug>) and app links. See docs/SHARING.md.
EXPO_PUBLIC_SHARE_DOMAIN=
# Google sign-in client ids (public). See docs/AUTH.md. Google is hidden until at least one is set.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Crash reporting (public DSN)
EXPO_PUBLIC_SENTRY_DSN=
# Build-time (prebuild / EAS), not an EXPO_PUBLIC var: APP_ENV=development allows plain-http API calls on Android.
# APP_ENV=development
